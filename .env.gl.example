# ═══════════════════════════════════════════════════════════
# TianJi (GL Edition) — Expo Frontend Environment Config
# Copy to .env and fill in real values
# ═══════════════════════════════════════════════════════════

# ── API Gateway ──
EXPO_PUBLIC_API_BASE_URL=http://localhost:3100
EXPO_PUBLIC_BFF_MODE=gl

# ── Brand ──
EXPO_PUBLIC_APP_NAME=TianJi
EXPO_PUBLIC_BRAND_COLOR=#0d1b2a
EXPO_PUBLIC_ACCENT_COLOR=#7b2cbf

# ── Deep Linking ──
EXPO_PUBLIC_LINKING_SCHEME=tianji

# ── Auth ──
EXPO_PUBLIC_AUTH_PROVIDER=jwt
EXPO_PUBLIC_AUTH_STORAGE=mmkv

# ── Analytics ──
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=

# ── Payments (International) ──
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID=
EXPO_PUBLIC_GOOGLE_PAY_MERCHANT_ID=

# ── EAS Build ──
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_UPDATE_URL=https://u.expo.dev
