# ═══════════════════════════════════════════════════════════
# 见己 (CN版) — Expo前端环境配置
# 复制为 .env 并填写真实值
# ═══════════════════════════════════════════════════════════

# ── API网关 ──
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_BFF_MODE=cn

# ── 品牌信息 ──
EXPO_PUBLIC_APP_NAME=见己
EXPO_PUBLIC_APP_NAME_EN=JianJi
EXPO_PUBLIC_BRAND_COLOR=#1a1a2e
EXPO_PUBLIC_ACCENT_COLOR=#e8c275

# ── 深度链接 ──
EXPO_PUBLIC_LINKING_SCHEME=jianji

# ── 认证 ──
EXPO_PUBLIC_AUTH_PROVIDER=jwt
EXPO_PUBLIC_AUTH_STORAGE=mmkv

# ── 分析 ──
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_SENTRY_DSN=

# ── 支付(国内) ──
EXPO_PUBLIC_WECHAT_PAY_APP_ID=
EXPO_PUBLIC_ALIPAY_APP_ID=

# ── EAS构建 ──
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_EAS_UPDATE_URL=https://u.expo.dev
